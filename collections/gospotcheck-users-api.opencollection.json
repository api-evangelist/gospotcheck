{
  "opencollection": "1.0.0",
  "info": {
    "name": "GoSpotCheck External AsyncJobs Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List users and user info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gospotcheck.com/external/v1/users",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number of results (defaults to 1)."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Records per page (defaults to 25, max 200)."
              },
              {
                "name": "include",
                "value": "",
                "type": "query",
                "description": "Comma-separated related resources to embed (e.g. teams,place_groups)."
              }
            ]
          },
          "docs": "List users and user info"
        },
        {
          "info": {
            "name": "Create one or multiple users",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.gospotcheck.com/external/v1/users",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create one or multiple users"
        },
        {
          "info": {
            "name": "Get the current authenticated user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gospotcheck.com/external/v1/users/me"
          },
          "docs": "Get the current authenticated user"
        },
        {
          "info": {
            "name": "Get a single user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gospotcheck.com/external/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get a single user"
        },
        {
          "info": {
            "name": "Update an existing user",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.gospotcheck.com/external/v1/users/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an existing user"
        },
        {
          "info": {
            "name": "View a user's manager permissions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.gospotcheck.com/external/v1/users/:id/permissions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "GSC user id or \"me\"."
              }
            ]
          },
          "docs": "Only GoSpotCheck admins or company_admin users may view permissions."
        },
        {
          "info": {
            "name": "Update a user's manager permissions",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.gospotcheck.com/external/v1/users/:id/permissions",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "GSC user id or \"me\"."
              }
            ]
          },
          "docs": "Update a user's manager permissions"
        }
      ]
    }
  ],
  "bundled": true
}